import base64
import zlib

_KE = b"vvnnvvnn@@"


def rc4_decrypt(data: bytes, key: bytes = None) -> bytes:
  if key is None:
    key = _KE

  S = list(range(256))
  j = 0
  for i in range(256):
    j = (j + S[i] + key[i % len(key)]) % 256
    S[i], S[j] = S[j], S[i]

  i_p = 0
  j_j = 0
  decrypted_list = []

  for byte in data:
    i_p = (i_p + 1) % 256
    j_j = (j_j + S[i_p]) % 256
    S[i_p], S[j_j] = S[j_j], S[i_p]
    k = S[(S[i_p] + S[j_j]) % 256]
    decrypted_list.append(byte ^ k)

  return bytes(decrypted_list)


def zlib_decompress(data: bytes) -> bytes:
  return zlib.decompress(data)


def base64_decode(data: str) -> bytes:
  return base64.b64decode(data)
